{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radar local saved connections and context assignments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "connections",
    "profiles"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "connections": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/connection"
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "imported": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "boolean"
        },
        "argocd": {
          "type": "boolean"
        },
        "cost": {
          "type": "boolean"
        }
      }
    },
    "dismissed": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metrics": {
            "type": "boolean"
          },
          "argocd": {
            "type": "boolean"
          },
          "cost": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "headersFromEnv": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "insecureTls": {
          "type": "boolean"
        }
      }
    },
    "kubecost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "tlsName": {
          "type": "string"
        },
        "insecureTls": {
          "type": "boolean"
        },
        "trust": {
          "type": "string"
        },
        "proxy": {
          "type": "string"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "metrics",
            "argocd",
            "cost"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "prometheus": {
          "$ref": "#/$defs/prometheus"
        },
        "argocd": {
          "$ref": "#/$defs/argocd"
        },
        "kubecost": {
          "$ref": "#/$defs/kubecost"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "metrics"
            },
            "prometheus": {
              "properties": {
                "url": {
                  "minLength": 1
                }
              }
            }
          },
          "required": [
            "prometheus"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "argocd"
                ]
              },
              {
                "required": [
                  "kubecost"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "argocd"
            },
            "argocd": {
              "properties": {
                "url": {
                  "minLength": 1
                }
              }
            }
          },
          "required": [
            "argocd"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "prometheus"
                ]
              },
              {
                "required": [
                  "kubecost"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "cost"
            },
            "kubecost": {
              "properties": {
                "url": {
                  "minLength": 1
                }
              }
            }
          },
          "required": [
            "kubecost"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "prometheus"
                ]
              },
              {
                "required": [
                  "argocd"
                ]
              }
            ]
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "connection",
            "prometheus",
            "kubecost"
          ]
        },
        "connectionId": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "argocd": {
          "$ref": "#/$defs/argocd"
        },
        "kubecost": {
          "$ref": "#/$defs/kubecost"
        },
        "clusterId": {
          "type": "string"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "integrations"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "inFileName": {
          "type": "string"
        },
        "capi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "managementBinding",
            "namespace",
            "name"
          ],
          "properties": {
            "managementBinding": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "integrations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "$ref": "#/$defs/assignment"
            },
            "argocd": {
              "$ref": "#/$defs/assignment"
            },
            "cost": {
              "$ref": "#/$defs/assignment"
            }
          }
        }
      }
    }
  }
}
