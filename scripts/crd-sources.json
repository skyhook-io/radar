    "istio": {
      "accessors": "resource-utils-istio.ts",
      "version": "1.24.2",
      "urls": [
        "https://raw.githubusercontent.com/istio/istio/1.24.2/manifests/charts/base/files/crd-all.gen.yaml"
      ]
    },
    "knative": {
      "accessors": "resource-utils-knative.ts",
      "version": "serving-v1.16.1 / eventing-v1.16.4",
      "urls": [
        "https://github.com/knative/serving/releases/download/knative-v1.16.1/serving-crds.yaml",
        "https://github.com/knative/eventing/releases/download/knative-v1.16.4/eventing-crds.yaml"
      ]
    },
    "traefik": {
      "accessors": "resource-utils-traefik.ts",
      "version": "v3.2.3",
      "urls": [
        "https://raw.githubusercontent.com/traefik/traefik/v3.2.3/integration/fixtures/k8s/01-traefik-crd.yml"
      ]
    },
    "contour": {
      "accessors": "resource-utils-contour.ts",
      "version": "v1.30.1",
      "urls": [
        "https://raw.githubusercontent.com/projectcontour/contour/v1.30.1/examples/contour/01-crds.yaml"
      ]
    },
    "capi": {
      "$comment": "Full release manifest; only its CRDs are read. Pinned to a release serving v1beta2 - the accessors read the v1beta2 contract first and fall back to v1beta1, so a v1beta1-only pin reports the forward half as broken.",
      "accessors": "resource-utils-capi.ts",
      "version": "v1.11.1",
      "urls": [
        "https://github.com/kubernetes-sigs/cluster-api/releases/download/v1.11.1/cluster-api-components.yaml"
      ]
    },
    "prometheus": {
      "accessors": "resource-utils-prometheus.ts",
      "version": "v0.79.2",
      "urls": [
        "https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.79.2/example/prometheus-operator-crd/monitoring.coreos.com_servicemonitors.yaml",
