{
  "$comment": [
    "Pinned upstream CRD schemas that Radar's resource accessors read.",
    "Each entry is regenerated into testdata/crd-schemas/<key>.json by",
    "scripts/crd-schema-sync.mjs. The generated files are committed so CI can",
    "validate offline; re-run the sync deliberately when bumping a pin.",
    "",
    "Pick the version Radar actually targets, not simply the newest. The accessors",
    "are written against a specific upstream release and a pin that trails it will",
    "report correct code as broken (velero status.queuePosition landed in 1.18)."
  ],
  "integrations": {
    "velero": {
      "accessors": "resource-utils-velero.ts",
      "version": "v1.18.0",
      "urls": [
        "https://raw.githubusercontent.com/vmware-tanzu/velero/v1.18.0/config/crd/v1/bases/velero.io_backups.yaml",
        "https://raw.githubusercontent.com/vmware-tanzu/velero/v1.18.0/config/crd/v1/bases/velero.io_restores.yaml",
        "https://raw.githubusercontent.com/vmware-tanzu/velero/v1.18.0/config/crd/v1/bases/velero.io_schedules.yaml",
        "https://raw.githubusercontent.com/vmware-tanzu/velero/v1.18.0/config/crd/v1/bases/velero.io_backupstoragelocations.yaml",
        "https://raw.githubusercontent.com/vmware-tanzu/velero/v1.18.0/config/crd/v1/bases/velero.io_volumesnapshotlocations.yaml",
        "https://raw.githubusercontent.com/vmware-tanzu/velero/v1.18.0/config/crd/v1/bases/velero.io_backuprepositories.yaml"
      ]
    },
    "cnpg": {
      "accessors": "resource-utils-cnpg.ts",
      "version": "release-1.27",
      "urls": [
        "https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.27/config/crd/bases/postgresql.cnpg.io_clusters.yaml",
        "https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.27/config/crd/bases/postgresql.cnpg.io_poolers.yaml",
        "https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.27/config/crd/bases/postgresql.cnpg.io_backups.yaml",
        "https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.27/config/crd/bases/postgresql.cnpg.io_scheduledbackups.yaml"
      ]
    },
    "certmanager": {
