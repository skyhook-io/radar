          ]
        }
      },
      "phase": "active",
      "outcome": "",
      "label": "Active",
      "level": "neutral"
    },
    {
      "name": "terminal Failed with its condition reason",
      "jobSet": {
        "apiVersion": "jobset.x-k8s.io/v1alpha2",
        "kind": "JobSet",
        "metadata": {
          "name": "train",
          "namespace": "ml"
        },
        "status": {
          "terminalState": "Failed",
          "conditions": [
            {
              "type": "Failed",
              "status": "True",
              "reason": "ReachedMaxRestarts"
            }
          ]
        }
      },
      "phase": "finished",
      "outcome": "failed",
      "label": "ReachedMaxRestarts",
      "level": "unhealthy"
    },
    {
      "name": "terminal Failed without a condition",
      "jobSet": {
