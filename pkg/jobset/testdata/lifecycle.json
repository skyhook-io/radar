{
  "description": "JobSet root lifecycle. Go's jobset.Lifecycle must return phase/outcome; the topology node (pkg/topology) and the UI status badge (getJobSetStatus) must show label at level. Condition types are unique per JobSet here, as the API keeps them.",
  "cases": [
    {
      "name": "controller has not reported",
      "jobSet": {
        "apiVersion": "jobset.x-k8s.io/v1alpha2",
        "kind": "JobSet",
        "metadata": {
          "name": "train",
          "namespace": "ml"
        }
      },
      "phase": "unknown",
      "outcome": "",
      "label": "Unknown",
      "level": "unknown"
    },
    {
      "name": "reported roles with no Jobs yet",
      "jobSet": {
        "apiVersion": "jobset.x-k8s.io/v1alpha2",
        "kind": "JobSet",
        "metadata": {
          "name": "train",
          "namespace": "ml"
        },
        "status": {
          "replicatedJobsStatus": [
            {
              "name": "workers"
            }
          ]
        }
      },
      "phase": "pending",
      "outcome": "",
      "label": "Pending",
      "level": "neutral"
    },
    {
      "name": "reported zero counts",
      "jobSet": {
        "apiVersion": "jobset.x-k8s.io/v1alpha2",
        "kind": "JobSet",
        "metadata": {
          "name": "train",
          "namespace": "ml"
        },
        "status": {
          "replicatedJobsStatus": [
            {
              "name": "workers",
              "active": 0,
              "ready": 0
            }
          ]
        }
      },
      "phase": "pending",
      "outcome": "",
      "label": "Pending",
      "level": "neutral"
    },
    {
      "name": "active children",
      "jobSet": {
        "apiVersion": "jobset.x-k8s.io/v1alpha2",
        "kind": "JobSet",
        "metadata": {
          "name": "train",
          "namespace": "ml"
        },
        "status": {
          "replicatedJobsStatus": [
            {
              "name": "workers",
              "active": 2,
              "ready": 1
            }
          ]
        }
      },
      "phase": "active",
      "outcome": "",
      "label": "Active",
      "level": "neutral"
    },
    {
      "name": "child failures alone are not terminal",
      "jobSet": {
        "apiVersion": "jobset.x-k8s.io/v1alpha2",
        "kind": "JobSet",
        "metadata": {
          "name": "train",
          "namespace": "ml"
